{
  "name": "curlgo-launch-video",
  "version": "0.1.0",
  "description": "CurlGo continuous-workspace product film with natural Chinese narration",
  "repository": "https://github.com/echoVic/curlgo",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "render": "remotion render src/index.ts CurlGoRoundtrip out/curlgo-roundtrip-zh.mp4 --codec h264 --crf 18 --pixel-format yuv420p",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "package-video": "python3 scripts/package_delivery.py"
  },
  "allowScripts": {
    "esbuild": false
  }
}
